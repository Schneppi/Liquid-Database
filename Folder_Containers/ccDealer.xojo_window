#tag Events txtURL
	#tag Event
		Sub FocusLost()
		  If Me.Enabled Then
		    
		    If Dealer = Nil Then Return
		    
		    Dealer.URL = Me.Text.Trim
		    Me.Text = Dealer.URL
		    
		  End If
		  
		End Sub
	#tag EndEvent
	#tag Event
		Function KeyDown(key As String) As Boolean
