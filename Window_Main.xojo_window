	#tag EndMenuHandler

	#tag MenuHandler
		Function WindowMainWindow() As Boolean Handles WindowMainWindow.Action
		  self.Show
		  
		  Return True
		  
		End Function
	#tag EndMenuHandler


	#tag Method, Flags = &h0
		Sub AddNewItem()
		  Main_Listbox.Enabled = False
		  
		  Select Case PagePanel_Main.SelectedPanelIndex
		    
		  Case 0
		    
		    Container_Liquid.Liquid = New Class_Liquid(Module_Multilanguage.kName)
		    LoadList
		    Window_Main.Main_Listbox.ScrollToID( Container_Liquid.Liquid.ID )
		    Container_Liquid.txtName.SetFocus()
		    
		  Case 1
		    
		    Container_Aroma.Aroma = New Class_Aroma( Module_Multilanguage.kName )
		    
		    LoadList
		    Window_Main.Main_Listbox.ScrollToID( Container_Aroma.Aroma.ID )
		    Container_Aroma.txtName.SetFocus()
		    
		  Case 2
		    
		    Container_Base.Base = New Class_Base(Module_Multilanguage.kName)
		    
		    Try
		      
		      LoadList
		      Window_Main.Main_Listbox.ScrollToID( Container_Base.Base.ID )
		      Container_Base.txtName.SetFocus()
		      
		    Catch err As DatabaseException
		      
		    End Try
		    
		  Case 3
		    
		    Container_Dealer.Dealer = New Class_Dealer(Module_Multilanguage.kName)
		    
		    Try
		      
		      LoadList
		      Window_Main.Main_Listbox.ScrollToID( Container_Dealer.Dealer.ID )
		      Container_Dealer.txtName.SetFocus()
		      
		    Catch err As DatabaseException
		      
		    End Try
		    
		  End Select
		  
		  Main_Listbox.Enabled = True
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub LoadList()
		  Main_Listbox.RemoveAllRows
		  
		  // Datenbank Liste Laden
		  
		  Select Case PagePanel_Main.SelectedPanelIndex
		    
		  Case 0 // Liquid
		    
		    Main_Listbox.List_Liquids( SearchField_SearchDB.Text )
		    
		  Case 1 // Aroma
		    
		    Main_Listbox.List_Flavors( SearchField_SearchDB.Text )
		    
		  Case 2 // Bases
		    
		    Main_Listbox.List_Bases( SearchField_SearchDB.Text )
		    
		  Case 3 // Dealer
		    
		    Main_Listbox.List_Dealers( SearchField_SearchDB.Text )
		    
		  End Select
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub PushTheButton(Caption As String)
		  Select Case Caption
		    
		  Case Module_Multilanguage.kLiquids // Liquids
		    
		    PagePanel_Main.SelectedPanelIndex = 0
		    UIStatus(True)
		    LoadList
		    
		  Case Module_Multilanguage.kFlavors // Aroma
		    
		    PagePanel_Main.SelectedPanelIndex = 1
		    UIStatus(True)
		    LoadList
		    
		  Case Module_Multilanguage.kBases // Bases
		    
		    PagePanel_Main.SelectedPanelIndex = 2
		    UIStatus(True)
		    LoadList
		    
		  Case Module_Multilanguage.kDealers // Dealer
		    
		    PagePanel_Main.SelectedPanelIndex = 3
		    UIStatus(True)
		    LoadList
		    
		  Case Module_Multilanguage.kStorage // Storage
		    
		    UIStatus(False)
		    PagePanel_Main.SelectedPanelIndex = 4
		    Container_Storage.dvStorage.RemoveAllRows
		    Container_Storage.btnRemoveFromStorage.Enabled = False
		    Container_Storage.ShowStorage
		    
		  End Select
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub SelectLabelPrinterFormat()
		  Dim ps As New PrinterSetup
		  If ps.ShowPageSetupDialog(Window_Main) Then
		    If ps<>Nil Then
		      App.Preferences.setStringValue("Printer Setup String", ps.Settings.DefineEncoding(Encodings.UTF8))
		    End If
		  End If
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UIStatus(VisibleStatus As Boolean)
		  Main_Listbox.Visible = VisibleStatus
		  Label_HelpStorage.Visible = Not VisibleStatus
		  
		  SearchField_SearchDB.Visible = VisibleStatus
		  SegmentedButton_AddRemove.Visible = VisibleStatus
		  
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h21
		Private BaseButton As DesktopToolbarButton
	#tag EndProperty

	#tag Property, Flags = &h21
		Private dbID2Scroll As Integer = 0
	#tag EndProperty

	#tag Property, Flags = &h21
		Private DealerButton As DesktopToolbarButton
	#tag EndProperty

	#tag Property, Flags = &h21
		Private FlavorButton As DesktopToolbarButton
	#tag EndProperty

	#tag Property, Flags = &h21
		Private LiquidsButton As DesktopToolbarButton
	#tag EndProperty

	#tag Property, Flags = &h21
		Private MaximumFlavorCountForCSVExport As Integer = 0
	#tag EndProperty

	#tag Property, Flags = &h21
		Private StorageButton As DesktopToolbarButton
	#tag EndProperty


#tag EndWindowCode

#tag Events PagePanel_Main
	#tag Event
		Sub PanelChanged()
		  // Folgender Code is erforderlich weil HelpTags unter macOS sonst nicht mehr funktionieren nachdem der Change Event aufgetreten ist.
		  // Das ist ein Xojo Fehler der hoffentlich irgendwann behoben wird.
		  Me.Visible = False
		  Me.Visible = True
		  
		  Select Case Me.SelectedPanelIndex
		    
		  Case 0
		    
		    LiquidsButton.Pressed = True
		    
		  Case 1
		    
		    FlavorButton.Pressed = True
		    
		  Case 2
		    
		    BaseButton.Pressed = True
		    
		  Case 3
		    
		    DealerButton.Pressed = True
		    
		  Case 4
		    
		    StorageButton.Pressed = True
		    
		  End Select
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Main_Listbox
	#tag Event
		Sub SelectionChanged()
		  If Me.SelectedRowIndex <> DesktopListBox.NoSelection Then
		    
		    Select Case PagePanel_Main.SelectedPanelIndex
		      
		    Case 0 // Liquid
		      
		      Container_Liquid.LoadLiquid( Me.RowTagAt( Me.SelectedRowIndex ).IntegerValue )
		      
		    Case 1 // Aroma
		      
		      Container_Aroma.LoadAroma( Me.RowTagAt( Me.SelectedRowIndex ).IntegerValue )
		      
		    Case 2 // Bases
		      
		      Container_Base.LoadBase( Me.RowTagAt( Me.SelectedRowIndex ).IntegerValue )
		      
		    Case 3 // Dealer
		      
		      Container_Dealer.LoadDealer( Me.RowTagAt( Me.SelectedRowIndex ).IntegerValue )
		      
		    Case 4 // Storage
		      
		      // Storage.UIState(False)
		      
		    End Select
		    
		  Else
		    
		    If Not Me.Enabled Then Return
		    
		    Select Case PagePanel_Main.SelectedPanelIndex
		      
		    Case 0 // Liquid
		      
		      Container_Liquid.Clear
		      
		    Case 1 // Aroma
		      
		      Container_Aroma.Clear
		      
		    Case 2 // Bases
		      
		      Container_Base.Clear
		      
		    Case 3 // Dealer
		      
		      Container_Dealer.Clear
		      
		    Case 4 // Storage
		      
		      // Storage.UIState(False)
		      
		    End Select
		    
		  End If
		End Sub
	#tag EndEvent
	#tag Event
		Sub Opening()
		  Me.SortingColumn = 0
		  LoadList()
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Label_HelpStorage
	#tag Event
		Sub Opening()
		  Me.Parent = Nil
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Toolbar_Main
	#tag Event
		Sub Pressed(item As DesktopToolbarItem)
		  PushTheButton(item.Caption)
		End Sub
	#tag EndEvent
	#tag Event
		Sub Opening()
		  Dim SpacerButton As New DesktopToolbarButton
		  SpacerButton.ButtonStyle = DesktopToolbarButton.ButtonStyles.FlexibleSpace
		  
		  LiquidsButton = New DesktopToolbarButton
		  FlavorButton = New DesktopToolbarButton
		  BaseButton = New DesktopToolbarButton
		  DealerButton = New DesktopToolbarButton
		  StorageButton = New DesktopToolbarButton
		  
		  LiquidsButton.Caption = Module_Multilanguage.kLiquids // Caption appears below the Icon
		  LiquidsButton.Name = Module_Multilanguage.kLiquids
		  LiquidsButton.Tooltip = Module_Multilanguage.kLiquids
		  If Color.IsDarkMode Then
		    LiquidsButton.icon = Liquid_DarkMode
		  Else
		    LiquidsButton.icon = Liquid_LightMode
		  End If
		  LiquidsButton.ButtonStyle = DesktopToolbarButton.ButtonStyles.ToggleButton
		  
		  FlavorButton.Caption = Module_Multilanguage.kFlavors
		  FlavorButton.Name = Module_Multilanguage.kFlavors
		  FlavorButton.Tooltip = Module_Multilanguage.kFlavors
		  If Color.IsDarkMode Then
		    FlavorButton.icon = Flavor_DarkMode
		  Else
		    FlavorButton.icon = Flavor_LightMode
		  End If
		  FlavorButton.ButtonStyle = DesktopToolbarButton.ButtonStyles.ToggleButton
		  
		  BaseButton.Caption = Module_Multilanguage.kBases
		  BaseButton.Name = Module_Multilanguage.kBases
		  BaseButton.Tooltip = Module_Multilanguage.kBases
		  If Color.IsDarkMode Then
		    BaseButton.icon = Base_DarkMode
		  Else
		    BaseButton.icon = Base_LightMode
		  End If
		  BaseButton.ButtonStyle = DesktopToolbarButton.ButtonStyles.ToggleButton
		  
		  DealerButton.Caption = Module_Multilanguage.kDealers
		  DealerButton.Name = Module_Multilanguage.kDealers
		  DealerButton.Tooltip = Module_Multilanguage.kDealers
		  If Color.IsDarkMode Then
		    DealerButton.icon = Dealer_DarkMode
		  Else
		    DealerButton.icon = Dealer_LightMode
		  End If
		  DealerButton.ButtonStyle = DesktopToolbarButton.ButtonStyles.ToggleButton
		  
		  StorageButton.Caption = Module_Multilanguage.kStorage
		  StorageButton.Name = Module_Multilanguage.kStorage
		  StorageButton.Tooltip = Module_Multilanguage.kStorage
		  If Color.IsDarkMode Then
		    StorageButton.icon = Storage_DarkMode
		  Else
		    StorageButton.icon = Storage_LightMode
		  End If
		  StorageButton.ButtonStyle = DesktopToolbarButton.ButtonStyles.ToggleButton
		  
		  Me.AddButton(LiquidsButton)
		  Me.AddButton(FlavorButton)
		  Me.AddButton(BaseButton)
		  Me.AddButton(SpacerButton)
		  Me.AddButton(DealerButton)
		  Me.AddButton(StorageButton)
		  
		  LiquidsButton.Pressed = True
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events SearchField_SearchDB
	#tag Event
		Sub TextChanged()
		  Select Case PagePanel_Main.SelectedPanelIndex
		    
		  Case 0,1,2,3 // Liquids, Aroma, Bases
		    
		    LoadList()
		    
		  Case 4 // Storage
		    
		    SearchField_SearchDB.Visible = False
		    SegmentedButton_AddRemove.Visible = False
		    LoadList()
		    
		  End Select
		End Sub
	#tag EndEvent
	#tag Event
		Sub Opening()
		  // Quick HAck weil Xojo ploetzlich zu hoch positionierte...
		  Me.Top = SegmentedButton_AddRemove.Top
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events SegmentedButton_AddRemove
	#tag Event
		Sub Pressed(segmentIndex As Integer)
		  Select Case segmentIndex
		    
		  Case 1
		    
		    If Main_Listbox.SelectedRowIndex = DesktopListBox.NoSelection Then Return
		    
		    Var s As String
		    Select Case PagePanel_Main.SelectedPanelIndex
		    Case 0
		      s = Module_Multilanguage.kLiquids
		    Case 1
		      s = Module_Multilanguage.kFlavors
		    Case 2
		      s = Module_Multilanguage.kBases
		    Case 3
		      s = Module_Multilanguage.kDealers
		    End Select
		    
		    Var n As Integer
		    If Main_Listbox.SelectedRowCount = 1 Then
		      n = MesBox( Module_Multilanguage.kRemoveItem.Replace( "$1", Main_Listbox.CellTextAt( Main_Listbox.SelectedRowIndex, 0 ) ) )
		    Else
		      n = MesBox( Module_Multilanguage.kRemoveItems.Replace( "$1", s ) )
		    End If
		    
		    If n = 6 Then
		      
		      Var X, Y As Integer
		      Y = Main_Listbox.RowCount - 1
		      
		      For X = Y DownTo 0
		        
		        If Main_Listbox.RowSelectedAt( X ) Then
		          
		          Select Case Window_Main.PagePanel_Main.SelectedPanelIndex
		            
		          Case 0 // Liquid
		            
		            If Container_Liquid.Liquid.Remove Then
		              Main_Listbox.RemoveRowAt(Main_Listbox.SelectedRowIndex)
		            End If
		            
		          Case 1 // Aroma
		            
		            If Container_Aroma.Aroma.Remove Then
		              Main_Listbox.RemoveRowAt(Main_Listbox.SelectedRowIndex)
		            End If
		            
		          Case 2 // Base
		            
		            If Container_Base.Base.Remove Then
		              Main_Listbox.RemoveRowAt(Main_Listbox.SelectedRowIndex)
		            End If
		            
		          Case 3 // Dealer
		            
		            If Container_Dealer.Dealer.Remove Then
		              Main_Listbox.RemoveRowAt(Main_Listbox.SelectedRowIndex)
		            End If
		            
		          End Select
		          
		        End If
		        
		      Next
		      
		      LoadList()
		      
		    End If
		    
		  Case 0
		    
		    AddNewItem
		    
		  End Select
		  
		End Sub
	#tag EndEvent
#tag EndEvents
