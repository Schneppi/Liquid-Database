#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Closing()
		  Self.SavePosition
		End Sub
	#tag EndEvent

	#tag Event
		Sub Opening()
		  Self.RestorePosition(True)
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h21
		Private Sub SaveSettings()
		  App.Preferences.setStringValue("mySQL Server Address", TextField_ServerAddress.Text)
		  App.Preferences.setStringValue("mySQL Username", TextField_Username.Text)
		  App.Preferences.setStringValue( "mySQL Password", TextField_Password.Text )
		  App.Preferences.setBooleanValue( "Use mySQL-Server", CheckBox_mySQLServer.Value )
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UnlockmySQLServerFields(Optional Unlock As Boolean = True)
		  TextField_ServerAddress.Enabled = Unlock
		  TextField_Username.Enabled = Unlock
		  TextField_Password.Enabled = Unlock
		End Sub
	#tag EndMethod


#tag EndWindowCode

#tag Events Labels
	#tag Event
		Sub Opening(index as Integer)
		  Me.Text = Me.Text + ":"
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events TextField_ServerAddress
	#tag Event
		Sub Opening()
		  Me.Text = App.Preferences.getStringValue("mySQL Server Address")
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events TextField_Username
	#tag Event
		Sub Opening()
		  Me.Text = App.Preferences.getStringValue("mySQL Username")
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events TextField_Password
	#tag Event
		Sub Opening()
		  Me.Text = App.Preferences.getStringValue("mySQL Password")
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events PushButton_Connect
	#tag Event
		Sub Pressed()
		  SaveSettings
		  Quit
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events CheckBox_mySQLServer
	#tag Event
		Sub ValueChanged()
		  UnlockmySQLServerFields(Me.Value)
		End Sub
	#tag EndEvent
	#tag Event
		Sub Opening()
		  Me.Value = App.Preferences.getBooleanValue( "Use mySQL-Server", False )
		End Sub
	#tag EndEvent
#tag EndEvents
